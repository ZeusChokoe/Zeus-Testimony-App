<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Only the local reading position/text size is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="reading.xml" />
        <include domain="sharedpref" path="library.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="reading.xml" />
        <include domain="sharedpref" path="library.xml" />
    </device-transfer>
</data-extraction-rules>
